{
  "name": "underwater-flappy",
  "version": "0.3.0",
  "description": "Flappy Bird-style 2D game set underwater — fluid dynamics core differentiator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "budget": "node scripts/check-budget.mjs",
    "ci": "npm run typecheck && npm run test && npm run build && npm run budget && npm run test:e2e"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
